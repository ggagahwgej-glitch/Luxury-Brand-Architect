# ─────────────────────────────────────────────────────────────
# LUXURY ESTATE — ENVIRONMENT CONFIGURATION
# Copy to `.env.local` and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Public site origin (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Data provider ────────────────────────────────────────────
# "supabase" (production) | "local" (development preview only)
DATA_PROVIDER=supabase

# ── Supabase (per-client project) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
# Server-only. NEVER prefix with NEXT_PUBLIC_. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public storage bucket for property media / brand assets
SUPABASE_STORAGE_BUCKET=property-media

# ── Admin session ────────────────────────────────────────────
# 32+ random bytes, base64. Generate: openssl rand -base64 48
ADMIN_SESSION_SECRET=replace-with-48-byte-random-string

# ── Local provider credentials (ignored when DATA_PROVIDER=supabase)
# Used only by the development preview provider. Never used in production.
LOCAL_OWNER_EMAIL=owner@aurumestates.com
LOCAL_OWNER_PASSWORD=RoyalAccess2026!
LOCAL_OWNER_CODE=741852963147
